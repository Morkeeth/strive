{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "outputDirectory": "dist",
  "redirects": [
    {"source":"/","has":[{"type":"query","key":"run","value":"(?<run>[0-9a-fA-F-]{36})"}],"missing":[{"type":"query","key":"legacy"}],"destination":"/api/legacy?run=:run","permanent":false},
    {"source":"/","has":[{"type":"query","key":"u","value":"(?<handle>[A-Za-z0-9_-]{1,40})"}],"missing":[{"type":"query","key":"legacy"}],"destination":"/api/legacy?u=:handle","permanent":false}
  ],
  "crons": [
    {
      "path": "/api/photo-cleanup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/feedback-notifications",
      "schedule": "0 4 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/proof/:id",
      "destination": "/api/proof?id=:id"
    },
    {
      "source": "/d/:id",
      "destination": "/api/decision?id=:id"
    },
    {
      "source": "/r/:id",
      "destination": "/api/run?id=:id"
    },
    {
      "source": "/l/:id/delete",
      "destination": "/api/link?id=:id&view=delete"
    },
    {
      "source": "/l/:id",
      "destination": "/api/link?id=:id"
    },
    {
      "source": "/:handle/:run",
      "destination": "/api/share?handle=:handle&run=:run"
    },
    {
      "source": "/:handle",
      "destination": "/api/share?handle=:handle"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/.well-known/:path*",
      "destination": "/.well-known/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm run build",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "functions": {
    "api/feedback-notifications.js": {
      "maxDuration": 60
    },
    "api/photo-cleanup.js": {
      "maxDuration": 60
    }
  }
}
